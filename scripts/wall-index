#!/usr/bin/env python3
"""Lists the wallpapers for the picker, with a thumbnail and a theme each.

    wall-index [folder ...]

Looks in the given folders, else <Pictures>/wallpapers (xdg-user-dir), two
levels deep, for images and videos. For each file it keeps, in
$XDG_CACHE_HOME/abyssal/wallpapers/, a 480 px JPEG thumbnail (a frame a
little into a video) and a JSON record: kind, size, length and a palette.
Records are reused until the file changes. Prints one JSON array.

The palette: the thumbnail's pixels (decoded by ffmpeg, so only ffmpeg and
the standard library are needed) are clustered with k-means in OKLab. The
accent is the most vivid colour weighted by how much of the picture it
covers; the second and third accents must sit at least 35 degrees of hue
away, else they are derived from the accent. Every accent is brought to a
readable pastel lightness, and the backgrounds are dark, lightly tinted
with the picture's dominant tone. Without ffmpeg, files are listed with no
thumbnail or palette.
"""
import hashlib
import json
import math
import os
import random
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

IMAGES = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif", ".avif", ".jxl"}
VIDEOS = {".mp4", ".mkv", ".webm", ".mov", ".avi", ".m4v"}
VERSION = 1
HOME = os.path.expanduser("~")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "abyssal", "wallpapers")
FFMPEG = shutil.which("ffmpeg")
FFPROBE = shutil.which("ffprobe")


def default_folders():
    pictures = ""
    if shutil.which("xdg-user-dir"):
        try:
            pictures = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True).stdout.strip()
        except OSError:
            pass
    if not pictures or pictures == HOME:
        pictures = os.path.join(HOME, "Pictures")
    return [os.path.join(pictures, name) for name in ("wallpapers", "Wallpapers")]


def find(folders):
    seen, out = set(), []
    for folder in folders:
        folder = os.path.expanduser(folder)
        if not os.path.isdir(folder):
            continue
        base = folder.rstrip("/").count("/")
        for root, dirs, files in os.walk(folder):
            if root.count("/") - base >= 2:
                dirs[:] = []
            dirs[:] = [d for d in dirs if not d.startswith(".")]
            for name in sorted(files):
                ext = os.path.splitext(name)[1].lower()
                path = os.path.join(root, name)
                if (ext in IMAGES or ext in VIDEOS) and path not in seen:
                    seen.add(path)
                    out.append(path)
    return out


# ── Colour maths (OKLab, Björn Ottosson) ─────────────────────────────────
def to_linear(c):
    c /= 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def from_linear(c):
    c = 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055
    return c * 255


def rgb_to_oklab(r, g, b):
    r, g, b = to_linear(r), to_linear(g), to_linear(b)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def oklab_to_rgb(L, a, b):
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (from_linear(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
            from_linear(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
            from_linear(-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s))


def oklch(L, C, h):
    """#rrggbb for an OKLCH colour, chroma lowered until it fits sRGB."""
    rad = math.radians(h)
    for _ in range(40):
        rgb = oklab_to_rgb(L, C * math.cos(rad), C * math.sin(rad))
        if all(-0.5 <= v <= 255.5 for v in rgb):
            break
        C *= 0.92
    return "#" + "".join("%02x" % max(0, min(255, round(v))) for v in rgb)


def hue_gap(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


def kmeans(points, k=8, rounds=12):
    rng = random.Random(7)
    centres = [rng.choice(points)]
    while len(centres) < k:  # k-means++ seeding, deterministic
        dist = [min(sum((p[i] - c[i]) ** 2 for i in range(3)) for c in centres) for p in points]
        total = sum(dist) or 1
        pick, acc = rng.random() * total, 0
        for p, d in zip(points, dist):
            acc += d
            if acc >= pick:
                centres.append(p)
                break
        else:
            centres.append(points[-1])
    for _ in range(rounds):
        groups = [[] for _ in centres]
        for p in points:
            best = min(range(len(centres)), key=lambda i: sum((p[j] - centres[i][j]) ** 2 for j in range(3)))
            groups[best].append(p)
        centres = [tuple(sum(p[j] for p in g) / len(g) for j in range(3)) if g else c for g, c in zip(groups, centres)]
    return [(c, len(g) / len(points)) for c, g in zip(centres, groups) if g]


def palette(pixels):
    points = [rgb_to_oklab(*px) for px in pixels]
    clusters = []
    for (L, a, b), share in kmeans(points):
        C = math.hypot(a, b)
        h = math.degrees(math.atan2(b, a)) % 360
        clusters.append({"L": L, "C": C, "h": h, "share": share})

    # The picture's overall tone: the biggest cluster's hue, if it has any.
    big = max(clusters, key=lambda c: c["share"])

    # Vivid and visible: chroma matters most, coverage a little, and colours
    # that are nearly black or white count less.
    def vivid(c):
        return c["C"] * c["share"] ** 0.35 * (1 - abs(c["L"] - 0.62))

    colourful = sorted((c for c in clusters if c["C"] > 0.035), key=vivid, reverse=True)
    if colourful:
        accent_h, accent_c = colourful[0]["h"], colourful[0]["C"]
    else:  # greyscale picture: a quiet accent in its tone, else violet
        accent_h, accent_c = (big["h"] if big["C"] > 0.01 else 295), 0.07

    hues = [accent_h]
    for c in colourful[1:]:
        if all(hue_gap(c["h"], h) >= 35 for h in hues):
            hues.append(c["h"])
        if len(hues) == 3:
            break
    if len(hues) < 2:
        hues.append((accent_h - 70) % 360)
    if len(hues) < 3:
        hues.append((accent_h + 60) % 360)

    def pastel(h, chroma):
        return oklch(0.80, max(0.08, min(0.15, chroma)), h)

    tone_h = big["h"] if big["C"] > 0.02 else accent_h
    tint = min(0.035, max(0.015, big["C"] * 0.4))

    def neutral(L, scale=1.0):
        return oklch(L, tint * scale, tone_h)

    return {
        "crust": neutral(0.14), "base": neutral(0.17), "surface0": neutral(0.215), "surface1": neutral(0.26),
        "overlay": neutral(0.50, 0.9), "subtext": neutral(0.77, 0.7), "text": neutral(0.94, 0.4),
        "accent": pastel(hues[0], accent_c * 1.1),
        "cyan": pastel(hues[1], accent_c * 0.9),
        "rose": pastel(hues[2], accent_c),
        # Status colours keep their meaning, nudged to the picture's tone.
        "warn": oklch(0.84, 0.11, 80), "danger": oklch(0.72, 0.15, 15), "success": oklch(0.83, 0.11, 155),
    }


# ── Per file ─────────────────────────────────────────────────────────────
def probe(path):
    if not FFPROBE:
        return 0, 0, 0
    try:
        out = subprocess.run([FFPROBE, "-v", "error", "-select_streams", "v:0", "-show_entries",
                              "stream=width,height:format=duration", "-of", "json", path],
                             capture_output=True, text=True, timeout=20).stdout
        data = json.loads(out or "{}")
        s = (data.get("streams") or [{}])[0]
        dur = float((data.get("format") or {}).get("duration") or 0)
        return int(s.get("width") or 0), int(s.get("height") or 0), dur
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0, 0, 0


def record(path):
    st = os.stat(path)
    key = hashlib.sha1(f"{path}\0{st.st_mtime_ns}\0{st.st_size}".encode()).hexdigest()[:20]
    meta, thumb = os.path.join(CACHE, key + ".json"), os.path.join(CACHE, key + ".jpg")
    try:
        with open(meta) as f:
            rec = json.load(f)
        if rec.get("version") == VERSION and rec.get("path") == path:
            return rec
    except (OSError, ValueError):
        pass

    ext = os.path.splitext(path)[1].lower()
    kind = "video" if ext in VIDEOS or (ext == ".gif") else "image"
    w, h, dur = probe(path)
    rec = {"version": VERSION, "path": path, "name": os.path.splitext(os.path.basename(path))[0],
           "kind": kind, "width": w, "height": h, "duration": round(dur, 1), "thumb": "", "palette": None}
    if FFMPEG:
        seek = ["-ss", str(min(1.0, dur / 3))] if ext in VIDEOS and dur > 0 else []
        ok = subprocess.run([FFMPEG, "-v", "error", "-y", *seek, "-i", path, "-frames:v", "1",
                             "-vf", "scale=480:-2", "-q:v", "4", thumb],
                            capture_output=True, timeout=60).returncode == 0
        if ok and os.path.exists(thumb):
            rec["thumb"] = thumb
            raw = subprocess.run([FFMPEG, "-v", "error", "-i", thumb, "-vf", "scale=96:54",
                                  "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
                                 capture_output=True, timeout=30).stdout
            pixels = [tuple(raw[i:i + 3]) for i in range(0, len(raw) - 2, 3)]
            if pixels:
                rec["palette"] = palette(pixels)
    tmp = meta + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f)
    os.replace(tmp, meta)
    return rec


def main():
    os.makedirs(CACHE, exist_ok=True)
    folders = sys.argv[1:] or default_folders()
    files = find(folders)
    with ThreadPoolExecutor(max_workers=min(4, os.cpu_count() or 2)) as pool:
        records = list(pool.map(lambda p: _safe(p), files))
    json.dump([r for r in records if r], sys.stdout)
    sys.stdout.write("\n")


def _safe(path):
    try:
        return record(path)
    except Exception as e:  # one broken file must not hide the rest
        print(f"wall-index: {path}: {e}", file=sys.stderr)
        return None


if __name__ == "__main__":
    main()
