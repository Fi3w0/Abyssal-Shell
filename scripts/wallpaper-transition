#!/usr/bin/env python3
"""Select a transition recipe, optionally changing a wallpaper in one IPC call."""
import argparse
import json
from pathlib import Path
import subprocess

root = Path(__file__).resolve().parent.parent
profiles = json.loads((root / 'wallpaper/transitions.json').read_text())
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('preset', choices=profiles)
parser.add_argument('image', nargs='?', help='Image or video to apply; omit to change only the default transition')
parser.add_argument('--output', default='', help='Output name; defaults to the active output')
args = parser.parse_args()
if args.image:
    path = Path(args.image).expanduser().resolve()
    if not path.is_file():
        parser.error('Wallpaper does not exist: ' + str(path))
    kind = 'video' if path.suffix.lower() in ('.mp4','.mkv','.webm','.mov','.avi','.m4v','.gif') else 'image'
    cmd = ['change', args.preset, str(path), args.output, kind]
else:
    cmd = ['preset', args.preset]
raise SystemExit(subprocess.call(['qs','-c','abyssal','ipc','call','wallpaper'] + cmd))
